generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  stripeAccountId      String?   // Stripe Customer ID (abonnement StayDirect)
  stripeSubscriptionId String?
  stripeConnectId      String?   // Stripe Connect Account ID (paiements voyageurs)
  paypalMe             String?   // Lien PayPal.Me pour propriétaires hors Stripe Connect
  skrillEmail          String?   // Email Skrill pour propriétaires sans société (Maroc etc.)
  sumupApiKey          String?   // Clé API SumUp pour paiements en ligne (Europe)
  channexApiKey        String?   // Clé API Channex (channel manager multi-OTA : Airbnb, Booking, Expedia...)
  siteminderApiKey     String?   // Clé API SiteMinder Direct Booking (générée par le client depuis son propre compte SiteMinder)
  phone                String?   // Numéro de téléphone affiché sur le site public
  whatsapp             String?   // Numéro WhatsApp (avec indicatif, ex: +33612345678)
  plan               String?   @default("starter") // starter, pro, business
  planExpiresAt      DateTime? // null = permanent
  businessType       String?   @default("meuble") // meuble, maison_hotes, hotel, appart_hotel, chambre_hotes, camping
  slug               String?   @unique
  // Personnalisation du site public
  siteTitle          String?
  tagline            String?
  logo               String?
  theme              String?   @default("modern") // modern, luxury, nature, minimal
  primaryColor       String?   @default("#2563eb")
  customDomain       String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  properties       Property[]
  promoRedemptions PromoRedemption[]
  securityDeposits SecurityDeposit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  address     String?
  city        String
  country     String   @default("France")
  pricePerNight       Float
  maxGuests           Int      @default(2)
  baseGuests          Int?     // nb voyageurs inclus dans le prix de base
  pricePerExtraGuest  Float?   // supplément par voyageur supplémentaire / nuit
  amenities           String[] // équipements personnalisés
  images      String[]
  icalUrls    String[]
  stock       Int      @default(1) // nb d'unités disponibles (1 pour meublé, 14 pour 14 studios identiques)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Channel manager Channex (synchro Airbnb/Booking/Expedia... via un connecteur PMS)
  channexPropertyId String?
  channexRoomTypeId String?
  channexRatePlanId String?
  channexDirty      Boolean   @default(false) // true = tarifs/dispos à repousser vers Channex
  channexSyncedAt   DateTime?

  // SiteMinder Direct Booking API — ici SiteMinder reste la source de vérité des tarifs/
  // dispos : on les récupère en lecture, on ne les pousse pas.
  siteminderPropertyId String?
  siteminderRoomTypeId String?
  siteminderRoomRateId String?
  siteminderSyncedAt   DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  blockedDates     BlockedDate[]
  priceOverrides   PriceOverride[]
  welcomeBook      WelcomeBook?
  securityDeposits SecurityDeposit[]
}

model Reservation {
  id              String   @id @default(cuid())
  propertyId      String
  guestName       String
  guestEmail      String
  guestPhone      String?
  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  totalPrice      Float
  status          String   @default("pending") // pending, confirmed, cancelled
  stripePaymentId String?
  source          String   @default("direct") // direct, airbnb, booking
  channexBookingId String? @unique // id de réservation Channex, pour dédupliquer les réservations reçues via le channel manager
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PriceOverride {
  id         String   @id @default(cuid())
  propertyId String
  date       DateTime
  price      Float
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
}

model PromoCode {
  id               String   @id @default(cuid())
  code             String   @unique
  type             String   @default("free_plan") // free_plan | discount
  plan             String?  // solo, petit, pro (pour type=free_plan)
  discountPercent  Int?     // 10, 20, 50... (pour type=discount)
  stripeCouponId   String?  // ID coupon Stripe (pour type=discount)
  maxUses          Int      @default(1)
  uses             Int      @default(0)
  expiresAt        DateTime?
  note             String?
  createdAt        DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  redeemedAt  DateTime  @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([promoCodeId, userId])
}

model WelcomeBook {
  id                   String   @id @default(cuid())
  propertyId           String   @unique
  // Accueil
  welcomeMessage       String?
  coverImage           String?
  // Check-in / Check-out
  checkInTime          String?
  checkOutTime         String?
  checkInInstructions  String?
  checkOutInstructions String?
  // WiFi
  wifiName             String?
  wifiPassword         String?
  // Règles
  houseRules           String?
  // Contact
  ownerPhone           String?
  emergencyPhone       String?
  // Infos pratiques (JSON arrays stockés en String)
  restaurants          String?  // JSON: [{name, description, distance}]
  activities           String?  // JSON: [{name, description}]
  transport            String?  // JSON: [{name, description}]
  localTips            String?  // texte libre
  // Stats
  views                Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model SecurityDeposit {
  id                String   @id @default(cuid())
  userId            String
  propertyId        String?
  // Voyageur
  guestName         String
  guestEmail        String
  guestPhone        String?
  // Caution
  amount            Float
  currency          String   @default("eur")
  // Dates séjour
  checkIn           DateTime?
  checkOut          DateTime?
  // Stripe
  stripePaymentIntentId String?
  stripeClientSecret    String?
  // Statut: pending | authorized | captured | released | expired | cancelled
  status            String   @default("pending")
  // Frais
  feeAmount         Float?   // frais facturés au voyageur
  feePercent        Float?   // % appliqué
  isSubscriber      Boolean  @default(false)
  // Notes
  note              String?
  capturedAt        DateTime?
  releasedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  plan      String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BlockedDate {
  id         String   @id @default(cuid())
  propertyId String
  date       DateTime
  source     String   @default("ical") // ical, manual
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
}
